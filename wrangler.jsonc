{
  // Worker de arquivos estáticos (plano gratuito) que serve openladder.app.
  // O "name" precisa ser igual ao nome do Worker no painel do Cloudflare.
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "openladder-landing",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
